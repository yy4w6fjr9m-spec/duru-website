# Base URL the QR codes point to. Defaults to the site's own address.
# VITE_PUBLIC_URL=https://your-site.vercel.app

# Client ID of your Spotify app (developer.spotify.com). Defaults to the one in src/lib/spotify.ts.
# Add <site address>/ (e.g. https://your-site.vercel.app/ and http://127.0.0.1:5173/)
# as Redirect URIs in the Spotify app settings.
# VITE_SPOTIFY_CLIENT_ID=
